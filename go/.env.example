# Pandemonium Environment Configuration
# If both GOOGLE_CLOUD_PROJECT and GOOGLE_GENAI_API_KEY are left unset,
# Pandemonium runs in deterministic mock mode (useful for offline testing).

# Option 1: Vertex AI Backend (Recommended for Google Cloud)
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# Option 2: Gemini Developer API Backend
# GOOGLE_GENAI_API_KEY=your-gemini-api-key

# Optional Model Overrides
# GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
